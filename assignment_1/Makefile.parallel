########################################################################
## Makefile — ECE1387 A1 parallel router (std::thread only)
########################################################################

VERBOSE ?= 1
ifeq ($(VERBOSE),1)
  ECHO :=
else
  ECHO := @
endif

# debug | release
CONF ?= debug

# compiler (let env override; ECF usually has g++)
CXX ?= g++

# output
TARGET_DIR := .
TARGET     := router_parallel

# GTK (3.x) via pkg-config
GTK_VER   := 3.0
GTK_CFLAGS := $(shell pkg-config --cflags gtk+-$(GTK_VER))
GTK_LIBS   := $(shell pkg-config --libs   gtk+-$(GTK_VER))

# EZGL sources (all .cpp in ezgl/)
EZGL_DIR  := ezgl
EZGL_SRCS := $(wildcard $(EZGL_DIR)/*.cpp)

# Router source: this is your std::thread version (not OpenMP)
ROUTER_SRC := router_parallel.cpp

# include paths
INC_DIRS := . $(EZGL_DIR) $(EZGL_DIR)/..

# common flags
CXXFLAGS := -Wall -std=c++14 -pthread
ifeq (release,$(CONF))
  CXXFLAGS += -O3 -DNDEBUG
else ifeq (debug,$(CONF))
  CXXFLAGS += -g
else
  $(error Invalid CONF: '$(CONF)'; use 'debug' or 'release')
endif

# default
all: $(TARGET_DIR)/$(TARGET)

# build
$(TARGET_DIR)/$(TARGET): Makefile $(ROUTER_SRC) $(EZGL_SRCS)
	$(ECHO) $(CXX) $(CXXFLAGS) \
	  $(foreach D,$(INC_DIRS),-I$D) $(GTK_CFLAGS) \
	  $(ROUTER_SRC) $(EZGL_SRCS) \
	  $(GTK_LIBS) -o $@

# run helpers
run: $(TARGET)
	./$(TARGET) -f $(FILE) -a $(ARCH) $(ARGS)

# sweep W (example: make sweep FILE=cct2.txt ARCH=topbottom)
sweep: $(TARGET)
	@for W in $$(seq 2 16); do \
	  echo "=== W=$$W ==="; \
	  ./$(TARGET) -f $(FILE) -a $(ARCH) -w $$W | grep -E "Routed|Used segments|failed" || true; \
	done

# quick tests
test1: $(TARGET)
	@echo "cct1, distributed, 4 threads"
	$(ECHO) ./$(TARGET) -f cct1.txt -a distributed -t 4

test1_single: $(TARGET)
	@echo "cct1, distributed, 1 thread"
	$(ECHO) ./$(TARGET) -f cct1.txt -a distributed -t 1

clean:
	$(ECHO) rm -f $(TARGET_DIR)/$(TARGET)

.PHONY: all run sweep test1 test1_single clean
